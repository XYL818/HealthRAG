# 复制成 .env 再填自己的 key。.env 已在 .gitignore 里，不会被提交。
#
# 默认配置走硅基流动（OpenAI 兼容协议）。
# 换成任何 OpenAI 兼容的服务，只改下面这几个变量即可，代码不用动。

# ---- 向量模型 ----
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_API_KEY=sk-在这里填你的key
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024

# ---- 生成模型 ----
# LLM_BASE_URL / LLM_API_KEY 不填则复用上面的向量配置
LLM_MODEL=deepseek-ai/DeepSeek-V3
# LLM_API_KEY=sk-如果生成模型用别的服务，在这里填

# ---- 重排 ----
ENABLE_RERANK=1
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---- 检索参数（一般不用改）----
# TOP_K_DENSE=20
# TOP_K_BM25=20
# TOP_N_RERANK=6
# 拒答判据：查询向量与语料的最高余弦低于此值就拒答。
# 0.60 是在 129 道评测题上标定的（域内 0.6408~0.8193，域外 0.4594~0.5780）。
# **换向量模型后必须重新标定**，见 eval/report.md 的「拒答判定」。
# MIN_QUERY_COSINE=0.60
# 兜底判据，只在取不到查询向量时才用。换重排模型后需要重新标定。
# MIN_RERANK_SCORE=0.15

# ---- RRF 融合参数 ----
# 下面三个默认值是扫参扫出来的（见 README「检索效果」与 eval/report.md）：
# 本语料上向量通道占主导，BM25 权重给 0.0 时 R@1/MRR 最高；
# 取 0.1 是为了重排候选池的 R@3 更高。换语料请重新扫，别照抄。
# RRF_K=60
# RRF_DENSE_WEIGHT=1.0
# RRF_BM25_WEIGHT=0.1
# 融合后进入重排的候选数
# RRF_CANDIDATES=24
# 关闭重排时改用它作为拒答阈值
# MIN_RRF_SCORE=0.008
